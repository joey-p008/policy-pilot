{
  "name": "@policy-pilot/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false && mkdir -p dist/config/prompts && cp src/config/prompts/*.txt dist/config/prompts/",
    "start": "node dist/main.js",
    "test": "jest --config ../../jest.config.js --passWithNoTests",
    "test:integration": "jest --config ../../jest.integration.config.js --runInBand",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "dependencies": {
    "@langchain/textsplitters": "^1.0.1",
    "@napi-rs/canvas": "^1.0.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/serve-static": "^5.0.5",
    "@policy-pilot/shared": "*",
    "@policy-pilot/shared-types": "*",
    "@prisma/client": "^6.19.3",
    "bullmq": "^5.81.3",
    "ioredis": "^6.0.0",
    "jose": "^4.15.9",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.28",
    "@types/supertest": "^7.2.1",
    "dotenv": "^17.4.2",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2"
  }
}
