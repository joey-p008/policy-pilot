DATABASE_URL="postgresql://policy_pilot:policy_pilot@localhost:5432/policy_pilot?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379

# OpenAI embeddings (text-embedding-3-small → vector(1536) on PolicyChunk)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_MAX_RETRIES=5
OPENAI_EMBEDDING_BATCH_SIZE=64

# OpenAI chat completions (structured decision recommendations)
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_MAX_RETRIES=5

# Optional. Isolates BullMQ keys per environment; integration tests set a unique value.
# REDIS_QUEUE_PREFIX=bull

# Execution domain: the downstream adapter contract, enforced on the
# access-grant-queue. Every entitlement grant passes through this ceiling.
# DOWNSTREAM_RATE_LIMIT_MAX=60
# DOWNSTREAM_RATE_LIMIT_WINDOW_MS=60000

# Ingest domain: how fast org-wide access events may arrive. Deliberately far
# above the downstream contract, because ingest only produces recommendations
# and never reaches a downstream adapter.
# ORG_BURST_RATE_LIMIT_MAX=300
# ORG_BURST_RATE_LIMIT_WINDOW_MS=60000

# Expected wall time of one ingest job (retrieval plus recommendation). Ingest
# worker concurrency is derived from it, so raise this if RAG latency grows or
# the worker becomes the bottleneck instead of the limiter.
# INGEST_EXPECTED_JOB_LATENCY_MS=2000

# Ingest retry tuning. ACCESS_REQUEST_JOB_ATTEMPTS is derived so cumulative
# exponential backoff outlasts one full window; override it only with that
# invariant in mind.
# ACCESS_REQUEST_BACKOFF_BASE_DELAY_MS=1000
# ACCESS_REQUEST_BACKOFF_MAX_JITTER_MS=250
# ACCESS_REQUEST_JOB_ATTEMPTS=8

# Grant retry tuning. Unlike ingest, this budget need not outlast a rate-limit
# window: a downstream rejection is answered with BullMQ's manual rate limit,
# which requeues the job without consuming an attempt. These attempts therefore
# only cover genuine transient faults.
# ACCESS_GRANT_BACKOFF_BASE_DELAY_MS=1000
# ACCESS_GRANT_JOB_ATTEMPTS=5

# OIDC resource-server config for HITL /access-requests (Bearer JWT).
# GET /health and POST /webhooks/access-requests stay public.
#
# Auth0 local recipe:
# 1. Create a Single Page Application (Authorization Code + PKCE).
#    Allowed Callback URLs: http://localhost:5173/callback
#    Allowed Logout URLs: http://localhost:5173
#    Allowed Web Origins: http://localhost:5173
# 2. Create an API whose identifier is OIDC_AUDIENCE. Without an audience
#    Auth0 issues an opaque token, not a JWT.
# 3. Add a Post-Login Action that copies Auth0 Roles named `user` / `admin`
#    onto the access token:
#      api.accessToken.setCustomClaim('https://policy-pilot.local/roles', roles);
# 4. JWT role claims map onto seeded HITL principals (user-042 / admin-123).
#    This slice does not JIT-provision `users` from `sub`.
#
# OIDC_ISSUER=https://your-tenant.auth0.com/
# OIDC_AUDIENCE=https://policy-pilot.local/api
# OIDC_ROLE_CLAIM=https://policy-pilot.local/roles
# Optional. JSON Web Key Set used by tests; omit in real environments so the
# verifier discovers jwks_uri from the issuer's OpenID configuration.
# OIDC_JWKS=
