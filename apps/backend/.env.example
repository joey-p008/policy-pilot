DATABASE_URL="postgresql://policy_pilot:policy_pilot@localhost:5432/policy_pilot?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional. Isolates BullMQ keys per environment; integration tests set a unique value.
# REDIS_QUEUE_PREFIX=bull

# Optional downstream rate-limit contract and BullMQ retry tuning.
# Defaults model the mock provider ceiling of 60 requests per 60s window.
# ACCESS_REQUEST_JOB_ATTEMPTS is derived so cumulative exponential backoff
# outlasts one full window; override it only with that invariant in mind.
# DOWNSTREAM_RATE_LIMIT_MAX=60
# DOWNSTREAM_RATE_LIMIT_WINDOW_MS=60000
# ACCESS_REQUEST_BACKOFF_BASE_DELAY_MS=1000
# ACCESS_REQUEST_BACKOFF_MAX_JITTER_MS=250
# ACCESS_REQUEST_JOB_ATTEMPTS=8
