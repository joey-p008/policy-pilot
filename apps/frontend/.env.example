VITE_API_BASE_URL=http://localhost:3000
# Set to "true" to serve mock RAG pending requests without NestJS HITL endpoints.
# Mock data still uses the OIDC session role (no in-app role switcher).
VITE_HITL_USE_MOCK_DATA=true

# SPA OIDC (Authorization Code + PKCE). No client secret.
# extraQueryParams.audience is required so Auth0 access tokens are JWTs.
# VITE_OIDC_AUTHORITY=https://your-tenant.auth0.com/
# VITE_OIDC_CLIENT_ID=
# VITE_OIDC_AUDIENCE=https://policy-pilot.local/api
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
# VITE_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
# VITE_OIDC_ROLE_CLAIM=https://policy-pilot.local/roles
